# ── Paper Trading (no wallet needed) ──────────────────────
# Wallets to copy (comma-separated, or "auto" to pick top from scanner)
TARGET_WALLETS=auto
# How many top wallets to auto-select
AUTO_TOP_COUNT=5

# Paper trading bankroll
BANKROLL=1000
# Copy size as % of their trade (0.1 = 10%)
POSITION_MULTIPLIER=0.1
# Max per trade in USDC
MAX_TRADE_SIZE=50
# Min per trade
MIN_TRADE_SIZE=1

# Poll interval in ms (how often to check for new trades)
POLL_INTERVAL=5000

# Dashboard port
DASHBOARD_PORT=3500

# ── Live Trading (requires funded wallet) ─────────────────
LIVE_MODE=false
WALLET_PRIVATE_KEY=
RPC_URL=
SIG_TYPE=0
PROXY_WALLET_ADDRESS=
POLYMARKET_GEO_TOKEN=
SLIPPAGE_TOLERANCE=0.02
ORDER_TYPE=FOK
MAX_SESSION_NOTIONAL=100
MAX_PER_MARKET_NOTIONAL=50
